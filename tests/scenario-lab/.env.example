# Bind published services to the peer-reachable interface (prefer private IPs).
API_BIND_IP=10.0.0.10
API_PORT=8080
FAULT_CONTROL_BIND_IP=10.0.0.10
RUVIO_BIND_IP=10.0.0.10
RUVIO_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-different-long-random-secret
RUVIO_DURABILITY=always
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=always
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.0.0.11:4317

# Observer host settings. SUT_ADDRESS may be public only with the peer firewall
# filter installed on both hosts as described in README.md.
SUT_ADDRESS=10.0.0.10
TARGET_URL=http://10.0.0.10:8080
FAULT_CONTROL_URL=http://10.0.0.10:8474
# Optional override when k6 containers need a different route than the host.
K6_FAULT_CONTROL_URL=
COLLECTOR_BIND_IP=10.0.0.11
GRAFANA_BIND_IP=10.0.0.11
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-another-long-random-secret
PROMETHEUS_RETENTION=30d

# k6 sustained profile defaults; increase only after checking host capacity.
DURATION=30m
CATALOG_RPS=80
ORDER_RPS=5
RATE_PROBE_RPS=5
FAULT_AFTER=5m
FAULT_DURATION=30s

# Bounded high-load profile: 14 sequential two-minute stages, including
# ramp-up, a step-down, recovery, and a second peak. Max VUs is a k6 setting,
# not a Ruvio/server capacity limit.
STRESS_RATES=50,100,200,400,600,800,1200,1600,2000,2400,3000,300,1600,3000
STRESS_STAGE_SECONDS=120
STRESS_PREALLOCATED_VUS=250
STRESS_MAX_VUS=4000
STRESS_MIN_MEMORY_AVAILABLE_PERCENT=10

# Paired backend comparison: eleven minutes total, plus setup and summary.
COMPARE_RATE_RPS=200
COMPARE_STAGE_SECONDS=300
COMPARE_GAP_SECONDS=60
COMPARE_PREALLOCATED_VUS=2000
COMPARE_MAX_VUS=2500
