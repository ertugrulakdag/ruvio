---
// Buttons that switch every [data-platform] block inside the surrounding [data-platform-scope].
import { platforms } from "../data/bench";
---

<div class="seg" role="group" aria-label="Measurement machine">
  {platforms.map((p, i) => (
    <button type="button" data-set-platform={p.id} aria-pressed={String(i === 0)}>{p.name}</button>
  ))}
</div>
