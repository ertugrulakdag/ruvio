---
// Every command in the CI-checked compatibility list as one square, grouped by family.
import { families, commands } from "../../data/bench";

const byFamily = new Map<string, string[]>();
for (const c of commands) byFamily.set(c.family, [...(byFamily.get(c.family) ?? []), c.name]);
const label: Record<string, string> = { data: "Data types", keys: "Keys and keyspace", ops: "Server and operations" };
---

<div class="mosaic-wrap">
  <div class="legend">
    {(["data", "keys", "ops"] as const).map((k) => <span><i class={`k-${k}`}></i>{label[k]}</span>)}
  </div>
  <div class="mosaic">
    {families.map((f) => (
      <div class={`fam k-${f.kind}`}>
        <div class="g">
          {(byFamily.get(f.family) ?? []).map((name) => <i tabindex="-1" data-tip={name} data-tip-sub={`${f.family}`}></i>)}
        </div>
        <span class="t"><b>{f.family}</b> {f.count}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .mosaic-wrap { display: grid; gap: 22px; }
  .legend i.k-data, .fam.k-data { --c: var(--c1); }
  .legend i.k-keys, .fam.k-keys { --c: var(--c2); }
  .legend i.k-ops, .fam.k-ops { --c: var(--c3); }
  .legend i { background: var(--c); }
  .mosaic { display: flex; flex-wrap: wrap; gap: 18px 24px; }
  .fam { display: grid; gap: 8px; align-content: start; }
  .g { display: grid; grid-template-columns: repeat(6, 11px); gap: 3px; }
  .g i { width: 11px; height: 11px; border-radius: 2px; background: var(--c); }
  .g i.is-on { outline: 2px solid var(--ink); outline-offset: 1px; }
  .t { font-family: var(--f-mono); font-size: 11.5px; color: var(--faint); white-space: nowrap; }
  .t b { color: var(--mute); font-weight: 500; }
</style>
