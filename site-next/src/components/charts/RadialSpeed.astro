---
// Diverging radial bars on a log2 scale around a dashed "Redis = 1×" ring.
// One bar per measured command, sorted fastest first; outward = faster than Redis, inward = slower.
import type { Platform } from "../../data/bench";
import { fmtOps, fmtX } from "../../data/bench";
import { sector, clamp } from "../../lib/geom";

interface Props { platform: Platform }
const { platform } = Astro.props;

const C = 280, RB = 156, K = 74, GAP = (30 * Math.PI) / 180;
const TICKS = [0.8, 1, 1.5, 2, 2.5];
const rr = (v: number) => RB + Math.log2(clamp(v, 0.6, 2.6)) * K;
const sorted = [...platform.rows].sort((a, b) => b.ratio - a.ratio);
const step = (2 * Math.PI - GAP) / sorted.length;
const start = -Math.PI / 2 + GAP / 2;
const bars = sorted.map((r, i) => {
  const a0 = start + i * step + step * 0.14;
  const a1 = start + (i + 1) * step - step * 0.14;
  const ro = rr(r.ratio);
  const lo = Math.min(RB, ro);
  const hi = Math.max(RB, ro) + (Math.abs(ro - RB) < 2 ? 2 : 0);
  const kind = r.ratio >= 1 ? "up" : r.ratio >= 0.97 ? "par" : "down";
  return { r, d: sector(C, C, lo, hi, a0, a1), kind };
});
---

<svg class="radial" viewBox="0 0 560 560" role="img"
  aria-label={`Throughput of ${platform.rows.length} commands relative to Redis ${platform.redisVersion} on ${platform.name}; geometric mean ${fmtX(platform.geomean)}`}>
  {TICKS.filter((v) => v !== 1).map((v) => <circle class="ring" cx={C} cy={C} r={rr(v).toFixed(2)} />)}
  {bars.map((b) => (
    <path class={`bar ${b.kind}`} d={b.d} tabindex="0"
      data-tip={b.r.label} data-tip-sub={`${fmtX(b.r.ratio)} Redis`} data-tip-sub2={`Ruvio ${fmtOps(b.r.ruvio)} · Redis ${fmtOps(b.r.redis)} ops/s`}>
      <title>{`${b.r.label}: ${fmtX(b.r.ratio)}`}</title>
    </path>
  ))}
  <circle class="ring one" cx={C} cy={C} r={RB} />
  {TICKS.map((v) => (
    <text class={`tick ${v === 1 ? "one" : ""}`} x={C} y={(C - rr(v) + 4).toFixed(2)} text-anchor="middle">{v === 1 ? "Redis 1×" : `${v}×`}</text>
  ))}
  <text class="center" x={C} y={C + 10} text-anchor="middle">{fmtX(platform.geomean)}</text>
  <text class="center-sub" x={C} y={C + 36} text-anchor="middle">geometric mean vs Redis</text>
</svg>

<style>
  .radial { display: block; width: 100%; height: auto; max-width: 560px; margin: 0 auto; overflow: visible; }
  .ring { fill: none; stroke: var(--line); stroke-width: 1; }
  .ring.one { stroke: var(--ink); stroke-opacity: 0.7; stroke-width: 1.5; stroke-dasharray: 4 4; pointer-events: none; }
  .bar { transition: opacity 0.15s ease; cursor: default; outline: none; }
  .bar.up { fill: var(--c1); }
  .bar.par { fill: var(--c2); }
  .bar.down { fill: var(--redis); }
  :global([data-chart].has-focus) .bar:not(.is-on) { opacity: 0.3; }
  .tick { font-family: var(--f-mono); font-size: 11px; fill: var(--mute); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; }
  .tick.one { fill: var(--ink); }
  .center { font-size: 60px; font-weight: 600; letter-spacing: -0.03em; fill: var(--ink); }
  .center-sub { font-size: 13px; fill: var(--mute); }
</style>
