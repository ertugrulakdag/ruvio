---
import Base from "../layouts/Base.astro";
---
<Base title="Contact — Ruvio" description="Form layout trial.">
  <main><div class="wrap" style="padding-bottom:80px">
    <div class="hero" style="padding-bottom:10px"><p class="kicker">Contact</p><h1>Talk to <em>us.</em></h1>
    <p class="lede">Layout trial only: this form does not send anything yet. A real one would post to an Azure Function.</p></div>
    <form class="contact" id="f">
      <label>Name<input name="name" required /></label>
      <label>Email<input name="email" type="email" required /></label>
      <label>Topic<select><option>Question</option><option>Bug report</option><option>Partnership</option></select></label>
      <label>Message<textarea rows="5" required></textarea></label>
      <button class="btn" type="submit">Send</button>
    </form>
    <div class="ok" id="ok">Thanks. (Nothing was sent: this is a design trial.)</div>
  </div></main>
  <script>
    document.getElementById("f")?.addEventListener("submit", (e) => { e.preventDefault(); (document.getElementById("ok") as HTMLElement).style.display = "block"; });
  </script>
</Base>
