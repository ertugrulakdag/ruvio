---
import Base from "../layouts/Base.astro";
const cases = [
  ["Rate limits and quotas", ["#LIMIT"], "A fixed window per API key, user or tenant in one command. A rejected call is not counted, and a quiet key disappears by itself.", "LIMIT api:key-7 100 60000\n# 99    -> 99 calls left\n# (nil) -> window is full"],
  ["Locks and fencing", ["#LEASE", "#RELEASE"], "One worker holds a named resource. Each grant returns a growing token you can send with writes to the protected system.", "LEASE job:nightly 30000\n# 17 -> you hold it, token 17\nRELEASE job:nightly 17\n# 1"],
  ["Inventory without overselling", ["#TAKE", "#INCRBY MAX"], "Subtract only when enough is left, or add only while under a cap. A refusal writes nothing.", "TAKE stock:ticket-42 2\n# 498   -> 498 left\n# (nil) -> not enough\nINCRBY seats:room-9 1 MAX 120"],
  ["Idempotent APIs", ["#IDEM", "#ONCE"], "A retry replays the stored answer instead of running the handler again.", "IDEM order:42 BEGIN digest attempt-1 60000\n# [\"acquired\"]\nIDEM order:42 COMPLETE digest attempt-1 saved\n# 1"],
  ["Delayed jobs", ["#XADD DELAY", "#streams"], "Schedule work for later with a consumer group, no separate scheduler.", "XADD jobs DELAY 30000 * kind reminder\nXREADGROUP GROUP workers w1 BLOCK 5000 STREAMS jobs >"],
  ["Cache fills without stampedes", ["#FILLGET", "#FILLSET"], "One caller refills an expired hot key; the others wait or serve the stale copy.", "FILLGET product:42 5000 WAIT 200\n# [FILL, token] -> you refill it\nFILLSET product:42 value 60000 <token>"],
];
---
<Base title="Use cases — Ruvio" description="What Ruvio is used for and how.">
  <main><div class="wrap">
    <div class="hero" style="padding-bottom:30px"><p class="kicker">Use cases</p><h1>What do you <em>build</em> with it?</h1>
    <p class="lede">The jobs people reach for, as you would type them in redis-cli.</p></div>
    {cases.map(([t, tags, d, code]) => (
      <div class="uc reveal"><div><h3>{t}</h3><p>{d}</p><div>{tags.map((x) => <span class="tag">{x}</span>)}</div></div><pre>{code}</pre></div>
    ))}
  </div></main>
</Base>
