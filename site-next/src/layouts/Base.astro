---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <a class="brand" href="/">Ruvio</a>
    <nav>
      <a href="#jobs">Jobs</a><a href="#speed">Speed</a><a href="#start">Start</a>
      <a class="pill" href="https://github.com/salihcantekin/ruvio">GitHub</a>
    </nav>
  </header>
  <slot />
  <footer class="foot">Server AGPL-3.0 · Clients MIT</footer>
  <script>
    const els = document.querySelectorAll(".reveal");
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      document.documentElement.classList.add("js-reveal");
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.15 });
      els.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>
<style is:global>
  :root { --bg:#f6f0e9; --ink:#2a1d17; --mute:#6b5a50; --accent:#c2472a; --card:#fff; --line:#e7dccf; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font-family:"IBM Plex Sans",system-ui,sans-serif; line-height:1.55; }
  code { font-family:"IBM Plex Mono",monospace; font-size:.92em; }
  .top { position:sticky; top:0; z-index:5; display:flex; justify-content:space-between; align-items:center; padding:14px 28px; background:color-mix(in srgb,var(--bg) 82%,transparent); backdrop-filter:blur(10px); border-bottom:1px solid var(--line); }
  .brand { font-weight:700; font-size:1.2rem; color:var(--ink); text-decoration:none; }
  nav { display:flex; gap:20px; align-items:center; }
  nav a { color:var(--mute); text-decoration:none; font-size:.95rem; }
  nav a:hover { color:var(--accent); }
  .pill { background:var(--accent); color:#fff !important; padding:6px 14px; border-radius:99px; }
  .wrap { max-width:1080px; margin:0 auto; padding:0 24px; }
  .hero { position:relative; overflow:hidden; padding:110px 0 90px; }
  .hero::before { content:""; position:absolute; inset:-30% -10% auto -10%; height:120%; z-index:-1;
    background:radial-gradient(40% 50% at 20% 30%, #f2b27a55, transparent 70%), radial-gradient(35% 45% at 80% 20%, #c2472a33, transparent 70%); }
  .kicker { color:var(--accent); font-weight:600; letter-spacing:.08em; text-transform:uppercase; font-size:.8rem; }
  h1 { font-size:clamp(2.2rem,5.5vw,4rem); line-height:1.08; margin:.3em 0; letter-spacing:-.02em; max-width:15em; }
  h1 em { font-style:normal; background:linear-gradient(90deg,#c2472a,#e8893a); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .lede { font-size:1.2rem; color:var(--mute); max-width:40em; }
  .btns { display:flex; gap:12px; margin-top:28px; flex-wrap:wrap; }
  .btn { padding:12px 22px; border-radius:12px; text-decoration:none; font-weight:600; background:var(--accent); color:#fff; transition:transform .15s, box-shadow .15s; }
  .btn:hover { transform:translateY(-2px); box-shadow:0 8px 22px #c2472a40; }
  .btn.quiet { background:transparent; color:var(--ink); border:1px solid var(--line); }
  section { padding:70px 0; }
  h2 { font-size:clamp(1.6rem,3vw,2.3rem); margin:0 0 .4em; letter-spacing:-.01em; }
  .sub { color:var(--mute); max-width:44em; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:18px; margin-top:32px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:18px; padding:22px; transition:transform .2s, box-shadow .2s, border-color .2s; position:relative; overflow:hidden; }
  .card::after { content:""; position:absolute; inset:0 0 auto 0; height:3px; background:linear-gradient(90deg,#c2472a,#e8893a); opacity:0; transition:opacity .2s; }
  .card:hover { transform:translateY(-4px); box-shadow:0 14px 32px #2a1d171a; border-color:#d9c3ad; }
  .card:hover::after { opacity:1; }
  .card h3 { margin:0 0 .4em; font-size:1.05rem; }
  .card p { margin:0; color:var(--mute); font-size:.95rem; }
  .stats { display:flex; gap:40px; flex-wrap:wrap; margin:30px 0 10px; }
  .stat b { display:block; font-size:2.6rem; letter-spacing:-.02em; color:var(--accent); }
  .stat span { color:var(--mute); font-size:.9rem; }
  .chart { background:var(--card); border:1px solid var(--line); border-radius:18px; padding:22px; margin-top:24px; }
  .row { display:grid; grid-template-columns:150px 1fr 56px; align-items:center; gap:12px; margin:7px 0; font-size:.88rem; }
  .row .lab { color:var(--mute); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .track { position:relative; height:14px; background:#f3eadf; border-radius:8px; }
  .bar { position:absolute; inset:0 auto 0 0; border-radius:8px; background:linear-gradient(90deg,#e8893a,#c2472a); transform-origin:left; }
  .mark { position:absolute; top:-4px; bottom:-4px; width:2px; background:var(--ink); opacity:.5; }
  .row b { text-align:right; font-family:"IBM Plex Mono",monospace; }
  .note { color:var(--mute); font-size:.82rem; margin-top:14px; }
  pre { background:#0d1018; color:#e8e6e1; border-radius:14px; padding:20px; overflow:auto; font-size:.9rem; }
  .foot { text-align:center; color:var(--mute); padding:40px; border-top:1px solid var(--line); }
  .js-reveal .reveal { opacity:0; transform:translateY(22px); transition:opacity .6s ease, transform .6s ease; }
  .js-reveal .reveal.in { opacity:1; transform:none; }
  .js-reveal .bar { transform:scaleX(0); transition:transform .9s cubic-bezier(.2,.7,.2,1); }
  .js-reveal .in .bar { transform:scaleX(1); }
  @media (max-width:640px) { .row { grid-template-columns:100px 1fr 48px; } .top { padding:12px 16px; } nav a:not(.pill){display:none;} }
  @media (prefers-reduced-motion: reduce) { * { transition:none !important; } }
</style>
