<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.1</Version>
    <Authors>Salih Cantekin</Authors>
    <Description>Explicitly opted-in, bounded HTTP idempotency for ASP.NET Core and Ruvio.</Description>
    <PackageId>Ruvio.AspNetCore.Idempotency</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ruvio-icon.png</PackageIcon>
    <PackageTags>ruvio;aspnetcore;idempotency</PackageTags>
    <RepositoryUrl>https://github.com/salihcantekin/ruvio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://salihcantekin.github.io/ruvio/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../clients/csharp/Ruvio.Client/Ruvio.Client.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../brand/ruvio-icon-square.png" Pack="true" PackagePath="ruvio-icon.png" />
    <InternalsVisibleTo Include="Ruvio.AspNetCore.Idempotency.Tests" />
    <InternalsVisibleTo Include="Ruvio.Integrations.Benchmarks" />
  </ItemGroup>
</Project>
